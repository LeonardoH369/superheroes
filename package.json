{
  "name": "superheroes",
  "version": "1.0.0",
  "private": true,
  "description": "superheroes CRUD académico Express + Sequelize",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:create": "sequelize-cli db:create",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
    "db:status": "sequelize-cli db:migrate:status",
    "test": "node --test tests/crud.test.js"
  },
  "dependencies": {
    "dotenv": "18.0.5",
    "express": "5.2.1",
    "sequelize": "6.37.8",
    "mysql2": "3.24.5",
    "ejs": "3.1.10"
  },
  "devDependencies": {
    "sequelize-cli": "6.6.5"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
