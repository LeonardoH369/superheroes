<%- include('../partials/header') %><div class="eyebrow">Archivo de identidades</div><div class="toolbar"><div><h1>Superhéroes</h1><p class="muted"><%= heroes.length %> fichas activas en tu colección</p></div><div class="actions"><a class="button secondary" href="/superheroes/trash">Ver papelera</a><a class="button" href="/superheroes/create">+ Registrar superhéroe</a></div></div>
<% if (!heroes.length) { %><section class="panel empty"><h2>Comienza tu colección</h2><p>Registra la primera identidad y su historia.</p></section><% } %>
<div class="grid"><% heroes.forEach(hero=>{ %><article class="card"><img src="<%= hero.photo_path %>" alt="Foto de <%= hero.alias %>" referrerpolicy="no-referrer"><div class="card-body"><span class="badge">Ficha #<%= hero.id %></span><h2><%= hero.alias %></h2><p class="muted"><%= hero.real_name %></p><div class="actions"><a href="/superheroes/<%= hero.id %>">Ver ficha</a><a href="/superheroes/<%= hero.id %>/edit">Editar</a><a class="danger-link" href="/superheroes/<%= hero.id %>/delete">Dar de baja</a></div></div></article><% }) %></div><%- include('../partials/footer') %>
