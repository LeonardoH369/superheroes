<%- include('../partials/header') %>
<a class="back" href="/superheroes">← Volver a superhéroes</a>
<div class="eyebrow">Identidad e historia</div><h1><%= title %></h1>
<p class="lead">Completa la ficha y selecciona una imagen desde tu computadora.</p>
<section class="panel form">
<% if(errors.length){ %><div class="error" role="alert"><% errors.forEach(error=>{ %><div><%= error %></div><% }) %><p>Si seleccionaste un archivo, vuelve a elegirlo antes de enviar.</p></div><% } %>
<form method="post" enctype="multipart/form-data" action="<%= hero.id ? '/superheroes/'+hero.id+'/update' : '/superheroes' %>">
<input type="hidden" name="_csrf" value="<%= csrf %>"><div class="fields">
<div class="field"><label for="real_name">Nombre real</label><input id="real_name" name="real_name" required maxlength="120" value="<%= hero.real_name || '' %>"></div>
<div class="field"><label for="alias">Nombre de superhéroe</label><input id="alias" name="alias" required maxlength="120" value="<%= hero.alias || '' %>"></div>
<div class="field full"><label for="photo">Fotografía local</label><input id="photo" name="photo" type="file" accept="image/jpeg,image/png,image/webp" <%= hero.id ? '' : 'required' %>><p class="muted">JPEG, PNG o WebP. Máximo 5 MB y 16 megapíxeles. <%= hero.id ? 'Deja este campo vacío para conservar la fotografía actual.' : '' %></p>
<% if(hero.photo_path){ %><img class="preview" src="<%= hero.photo_path %>" alt="Fotografía actual"><% } %></div>
<div class="field full"><label for="information">Información adicional</label><textarea id="information" name="information" required maxlength="8000"><%= hero.information || '' %></textarea></div></div>
<div class="actions"><button type="submit"><%= hero.id ? 'Guardar cambios' : 'Registrar superhéroe' %></button><a href="/superheroes">Cancelar</a></div></form></section>
<%- include('../partials/footer') %>
