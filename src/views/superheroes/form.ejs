<%- include('../partials/header') %><a class="back" href="/superheroes">← Volver a superhéroes</a><div class="eyebrow">Identidad e historia</div><h1><%= title %></h1><p class="lead">Completa los cuatro campos para guardar la ficha.</p><section class="panel form"><% if(errors.length){ %><div class="error" role="alert"><% errors.forEach(error=>{ %><div><%= error %></div><% }) %></div><% } %><form method="post" action="<%= hero.id ? '/superheroes/'+hero.id+'/update' : '/superheroes' %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="fields"><div class="field"><label for="real_name">Nombre real</label><input id="real_name" name="real_name" required maxlength="120" value="<%= hero.real_name || '' %>"></div><div class="field"><label for="alias">Nombre de superhéroe</label><input id="alias" name="alias" required maxlength="120" value="<%= hero.alias || '' %>"></div><div class="field full"><label for="photo_url">URL de la foto</label><input id="photo_url" name="photo_url" type="url" required maxlength="2048" placeholder="https://..." value="<%= hero.photo_url || '' %>"></div><div class="field full"><label for="information">Información adicional</label><textarea id="information" name="information" required maxlength="8000"><%= hero.information || '' %></textarea></div></div><div class="actions"><button type="submit"><%= hero.id ? 'Guardar cambios' : 'Registrar superhéroe' %></button><a href="/superheroes">Cancelar</a></div></form></section><%- include('../partials/footer') %>
